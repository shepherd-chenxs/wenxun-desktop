{
  "name": "wenxun",
  "version": "2.5.1",
  "description": "桌面文章编辑应用",
  "scripts": {
    "dev": "chcp 65001 && vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri:dev": "chcp 65001 && tauri dev",
    "tauri:build": "tauri build && node scripts/copy-installer.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:frontend": "powershell -ExecutionPolicy Bypass -File tests/scripts/run-frontend.ps1",
    "test:backend": "powershell -ExecutionPolicy Bypass -File tests/scripts/run-backend.ps1",
    "test:all": "powershell -ExecutionPolicy Bypass -File tests/scripts/run-all.ps1",
    "test:coverage-report": "powershell -ExecutionPolicy Bypass -File tests/scripts/coverage-report.ps1"
  },
  "keywords": [
    "tauri",
    "markdown-editor",
    "wechat-mp",
    "ai-writing"
  ],
  "author": "shepherd-chenxs",
  "license": "MIT",
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@uiw/react-md-editor": "^4.1.0",
    "antd": "^5.12.5",
    "dayjs": "^1.11.10",
    "formik": "^2.4.9",
    "marked": "^18.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.14.2",
    "sql.js": "^1.14.1",
    "yup": "^1.7.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.5.6",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-junit": "^17.0.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}
